@page "/bestaende"
@using Microsoft.EntityFrameworkCore
@using ShopHub.Web.Data
@using ShopHub.Web.Models
@using ShopHub.Web.Services
@inherits MandantSeite
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Bestände</PageTitle>

<h1>Bestände</h1>

@if (MandantNr is null)
{
    <div class="alert alert-warning">Dem Konto ist kein Mandant zugeordnet.</div>
    return;
}

@if (!string.IsNullOrEmpty(_meldung))
{
    <div class="alert alert-success">@_meldung</div>
}
@if (!string.IsNullOrEmpty(_fehler))
{
    <div class="alert alert-danger">@_fehler</div>
}

@if (_lagerplaetze.Count == 0)
{
    <div class="alert alert-warning">Es ist noch kein aktiver Lagerplatz angelegt - bitte zuerst unter <a href="/lagerplaetze">Lagerplätze</a> einen anlegen.</div>
    return;
}

<div class="border rounded p-3 mb-3">
    <div class="d-flex align-items-center gap-3 mb-2">
        <label class="mb-0">Lagerplatz</label>
        <select class="form-select form-select-sm" style="width: 260px;" @bind="_lagerplatzId" @bind:after="LadeAsync">
            @foreach (var l in _lagerplaetze)
            {
                <option value="@l.LagerplatzID">@l.Bezeichnung</option>
            }
        </select>
        <input class="form-control form-control-sm" style="width: 280px;" placeholder="Artikelnummer, Bezeichnung oder EAN"
               @bind="_suche" @bind:event="oninput" @onkeydown="SucheTaste" />
        <button type="button" class="btn btn-sm btn-primary" @onclick="Suchen">Suchen</button>
        <label class="mb-0">
            <input type="checkbox" class="form-check-input" @bind="_nurAktive" @bind:after="LadeAsync" /> nur aktive
        </label>
    </div>
    <div class="text-muted mb-2">Eine Änderung wird beim Verlassen des Feldes sofort gespeichert. Varianten ohne Bestandszeile zeigen 0.</div>

    @if (_zeilen.Count == 0)
    {
        <p class="text-muted mb-0">Keine passenden Varianten gefunden.</p>
    }
    else
    {
        <table class="table table-sm calc-table mb-0" style="width: auto;">
            <thead>
                <tr>
                    <th>Artikelnummer</th>
                    <th>Bezeichnung</th>
                    <th class="text-end">Bestand</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var z in _zeilen)
                {
                    <tr>
                        <td style="text-align: left;">@z.Artikelnummer</td>
                        <td style="text-align: left;">@z.Anzeigename</td>
                        <td class="text-end">
                            <input type="number" class="form-control form-control-sm" style="width: 110px; text-align: right;"
                                   min="0" value="@z.Bestand" data-german-number-input @onchange="e => SetzeBestand(z, e.Value?.ToString())" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_abgeschnitten)
        {
            <div class="text-muted mt-2">Nur die ersten @MaxZeilen Treffer werden angezeigt - bitte die Suche eingrenzen.</div>
        }
    }
</div>

@code {
    private const int MaxZeilen = 100;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Pfeil hoch/runter springt zwischen den Bestandsfeldern (wie in allen Zahlentabellen).
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/germanNumberInputNav.js");
            await module.InvokeVoidAsync("init");
        }
    }

    private sealed class Zeile
    {
        public int ArtikelvarianteID { get; init; }
        public string Artikelnummer { get; init; } = "";
        public string SKU { get; init; } = "";
        public string Anzeigename { get; init; } = "";
        public int Bestand { get; set; }
    }

    private List<Lagerplatz> _lagerplaetze = [];
    private List<Zeile> _zeilen = [];
    private int _lagerplatzId;
    // _suche ist der getippte Text, _gesuchtNach der Text der letzten Suche (Schaltfläche "Suchen" oder Eingabetaste, wie in der Artikelliste).
    private string _suche = "";
    private string _gesuchtNach = "";
    private bool _nurAktive = true;
    private bool _abgeschnitten;
    private string? _meldung;
    private string? _fehler;

    protected override async Task LadeAsync()
    {
        _zeilen = [];
        if (MandantNr is not { } mandantNr) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        _lagerplaetze = await db.Lagerplaetze.AsNoTracking()
            .Where(l => l.MandantNr == mandantNr && l.Aktiv)
            .OrderBy(l => l.Bezeichnung)
            .ToListAsync();
        if (_lagerplaetze.Count == 0) return;

        // Nach einem Mandantenwechsel gehört der gewählte Lagerplatz evtl. nicht mehr dazu.
        if (_lagerplaetze.All(l => l.LagerplatzID != _lagerplatzId))
        {
            _lagerplatzId = _lagerplaetze[0].LagerplatzID;
        }

        var lagerplatzId = _lagerplatzId;
        var abfrage = db.Artikelvarianten.AsNoTracking().Where(v => v.MandantNr == mandantNr);
        if (_nurAktive)
        {
            abfrage = abfrage.Where(v => v.Aktiv && v.Artikel!.Aktiv);
        }

        var suche = _gesuchtNach;
        if (suche.Length > 0)
        {
            abfrage = abfrage.Where(v => (v.GTIN != null && v.GTIN.Contains(suche))
                || (v.Variantenname != null && v.Variantenname.Contains(suche))
                || v.Artikel!.Artikelnummer.Contains(suche) || v.Artikel.Bezeichnung.Contains(suche));
        }

        var treffer = await abfrage
            .OrderBy(v => v.Artikel!.Artikelnummer).ThenBy(v => v.SKU)
            .Take(MaxZeilen + 1)
            .Select(v => new
            {
                v.ArtikelvarianteID, v.Artikel!.Artikelnummer, v.SKU, v.Artikel.Bezeichnung, v.Variantenname,
                Bestand = db.ArtikelBestaende
                    .Where(b => b.MandantNr == mandantNr && b.LagerplatzID == lagerplatzId && b.ArtikelvarianteID == v.ArtikelvarianteID)
                    .Select(b => (int?)b.Bestand)
                    .FirstOrDefault(),
            })
            .ToListAsync();

        _abgeschnitten = treffer.Count > MaxZeilen;
        _zeilen = treffer.Take(MaxZeilen).Select(t => new Zeile
        {
            ArtikelvarianteID = t.ArtikelvarianteID,
            Artikelnummer = t.Artikelnummer,
            SKU = t.SKU,
            Anzeigename = string.IsNullOrWhiteSpace(t.Variantenname) ? t.Bezeichnung : $"{t.Bezeichnung} – {t.Variantenname}",
            Bestand = t.Bestand ?? 0,
        }).ToList();
    }

    private async Task Suchen()
    {
        _gesuchtNach = _suche.Trim();
        await LadeAsync();
    }

    private async Task SucheTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Suchen();
    }

    private async Task SetzeBestand(Zeile zeile, string? wert)
    {
        _meldung = _fehler = null;
        if (MandantNr is not { } mandantNr) return;
        if (!int.TryParse(wert, out var bestand) || bestand < 0)
        {
            _fehler = $"Der Bestand für {zeile.SKU} muss eine ganze Zahl ab 0 sein.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var zeileDb = await db.ArtikelBestaende.FirstOrDefaultAsync(b =>
            b.MandantNr == mandantNr && b.LagerplatzID == _lagerplatzId && b.ArtikelvarianteID == zeile.ArtikelvarianteID);
        if (zeileDb is null)
        {
            db.ArtikelBestaende.Add(new ArtikelBestand
            {
                MandantNr = mandantNr,
                LagerplatzID = _lagerplatzId,
                ArtikelvarianteID = zeile.ArtikelvarianteID,
                Bestand = bestand,
            });
        }
        else
        {
            zeileDb.Bestand = bestand;
        }

        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateException ex) when (DbFehler.IstEindeutigkeitsverletzung(ex))
        {
            _fehler = $"Der Bestand für {zeile.SKU} wurde gleichzeitig geändert - bitte Seite neu laden.";
            return;
        }

        zeile.Bestand = bestand;
        _meldung = $"Bestand für {zeile.SKU} gespeichert.";
    }
}
