@page "/mandant-bearbeiten/{MandantNr:int}"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ShopHub.Web.Data
@using ShopHub.Web.Models
@using ShopHub.Web.Services
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MandantKontext Kontext

<PageTitle>@(_istAdmin ? "Mandant bearbeiten" : "Firmendaten")</PageTitle>

@* Admins pflegen jeden Mandanten (Liste unter /mandanten); normale Benutzer als "Firmendaten" nur den eigenen. *@
<div class="d-flex justify-content-between align-items-start">
    <h1>@(_istAdmin ? $"Mandant {MandantNr}" : "Firmendaten")</h1>
    <button type="button" class="btn-close" aria-label="Schließen" @onclick='() => Nav.NavigateTo(_istAdmin ? "/mandanten" : "/")'></button>
</div>

@if (!string.IsNullOrEmpty(_meldung))
{
    <div class="alert alert-success">@_meldung</div>
}
@if (!string.IsNullOrEmpty(_fehler))
{
    <div class="alert alert-danger" style="white-space: pre-wrap;">@_fehler</div>
}

@if (_mandant is null)
{
    <div class="alert alert-warning">Den Mandanten @MandantNr gibt es nicht.</div>
    return;
}

<div class="border rounded p-3 mb-3">
    <h5>Stammdaten</h5>
    <table class="table table-sm calc-table mb-0" style="width: auto;">
        <tbody>
            <tr>
                <td class="calc-label">Firmenname</td>
                <td><input class="form-control form-control-sm" style="width: 420px;" maxlength="200" @bind="_mandant.Bezeichnung" /></td>
            </tr>
            <tr>
                <td class="calc-label">Geschäftsführer</td>
                <td><input class="form-control form-control-sm" style="width: 420px;" maxlength="200" @bind="_mandant.Geschaeftsfuehrer" /></td>
            </tr>
            <tr>
                <td class="calc-label">Straße</td>
                <td><input class="form-control form-control-sm" style="width: 420px;" maxlength="200" @bind="_mandant.Strasse" /></td>
            </tr>
            <tr>
                <td class="calc-label">PLZ</td>
                <td><input class="form-control form-control-sm" style="width: 110px;" maxlength="20" inputmode="numeric" data-eingabefilter="ziffern" @bind="_mandant.Plz" /></td>
            </tr>
            <tr>
                <td class="calc-label">Ort</td>
                <td><input class="form-control form-control-sm" style="width: 320px;" maxlength="100" @bind="_mandant.Ort" /></td>
            </tr>
            <tr>
                <td class="calc-label">Land</td>
                <td><input class="form-control form-control-sm" style="width: 220px;" maxlength="100" @bind="_mandant.Land" /></td>
            </tr>
            <tr>
                <td class="calc-label">Telefon</td>
                <td><input class="form-control form-control-sm" style="width: 220px;" maxlength="50" inputmode="numeric" data-eingabefilter="ziffern" @bind="_mandant.Telefon" /></td>
            </tr>
            <tr>
                <td class="calc-label">E-Mail</td>
                <td><input type="email" class="form-control form-control-sm" style="width: 320px;" maxlength="200" @bind="_mandant.EMail" /></td>
            </tr>
            <tr>
                <td class="calc-label">Bankname</td>
                <td><input class="form-control form-control-sm" style="width: 320px;" maxlength="100" @bind="_mandant.Bankname" /></td>
            </tr>
            <tr>
                <td class="calc-label">IBAN</td>
                <td><input class="form-control form-control-sm" style="width: 320px;" maxlength="34" placeholder="z. B. DE89370400440532013000" data-eingabefilter="land-ziffern" @bind="_mandant.Iban" /></td>
            </tr>
            <tr>
                <td class="calc-label">HR Nummer</td>
                <td><input class="form-control form-control-sm" style="width: 220px;" maxlength="50" placeholder="z. B. HRB 12345" @bind="_mandant.HrNummer" /></td>
            </tr>
            <tr>
                <td class="calc-label">Amtsgericht</td>
                <td><input class="form-control form-control-sm" style="width: 320px;" maxlength="100" placeholder="z. B. Amtsgericht Essen" @bind="_mandant.Amtsgericht" /></td>
            </tr>
            <tr>
                <td class="calc-label">Steuernummer</td>
                <td><input class="form-control form-control-sm" style="width: 220px;" maxlength="30" @bind="_mandant.Steuernummer" /></td>
            </tr>
            <tr>
                <td class="calc-label">USt-Id Nummer</td>
                <td><input class="form-control form-control-sm" style="width: 220px;" maxlength="20" placeholder="z. B. DE123456789" data-eingabefilter="land-ziffern" @bind="_mandant.UstIdNr" /></td>
            </tr>
            <tr>
                <td class="calc-label">EORI-Nummer</td>
                <td><input class="form-control form-control-sm" style="width: 220px;" maxlength="20" placeholder="z. B. DE123456789012345" data-eingabefilter="land-ziffern" @bind="_mandant.EoriNummer" /></td>
            </tr>
            <tr>
                <td class="calc-label">Lucid ID</td>
                <td><input class="form-control form-control-sm" style="width: 220px;" maxlength="20" placeholder="z. B. DE1234567890123456" @bind="_mandant.LucidId" /></td>
            </tr>
            @if (_istAdmin)
            {
                <tr>
                    <td class="calc-label">Aktiv</td>
                    <td style="text-align: left;"><input type="checkbox" class="form-check-input" @bind="_mandant.Aktiv" /></td>
                </tr>
            }
        </tbody>
    </table>
    <button type="button" class="btn btn-primary mt-3" @onclick="Speichern">Speichern</button>
</div>

<div class="border rounded p-3 mb-3">
    <h5>Logo</h5>
    <table class="table table-sm calc-table mb-0" style="width: auto;">
        <tbody>
            <tr>
                <td class="calc-label">Aktuelles Logo</td>
                <td style="text-align: left;">
                    @if (_hatLogo)
                    {
                        <img src="/mandant-logo/@MandantNr?v=@_logoVersion" alt="Logo" style="max-height: 80px; max-width: 240px;" />
                    }
                    else
                    {
                        <span class="text-muted">Kein Logo hinterlegt.</span>
                    }
                </td>
            </tr>
            <tr>
                <td class="calc-label">Neue Datei (PNG/JPEG, max. 512 KB)</td>
                <td><InputFile class="form-control form-control-sm" style="width: 420px;" accept=".png,.jpg,.jpeg" OnChange="LogoHochladen" /></td>
            </tr>
        </tbody>
    </table>
    @if (_hatLogo)
    {
        <button type="button" class="btn btn-outline-danger mt-3" @onclick="LogoEntfernen">Logo entfernen</button>
    }
    <div class="text-muted mt-2">Das Logo wird sofort gespeichert.</div>
</div>

@code {
    [Parameter] public int MandantNr { get; set; }

    private Mandant? _mandant;
    private bool _istAdmin;
    // Admins dürfen jeden Mandanten bearbeiten, alle anderen nur den ihres Kontos.
    private bool _erlaubt;
    private bool _hatLogo;
    private long _logoVersion;
    private string? _meldung;
    private string? _fehler;

    protected override async Task OnParametersSetAsync() => await Laden();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var modul = await JS.InvokeAsync<IJSObjectReference>("import", "/js/eingabefilter.js");
            await modul.InvokeVoidAsync("init");
        }
    }

    private async Task Laden()
    {
        _istAdmin = await Kontext.IstAdminAsync();
        _erlaubt = _istAdmin || await Kontext.GetMandantNrAsync() == MandantNr;
        if (!_erlaubt)
        {
            // Wie "gibt es nicht": fremde Mandanten werden nicht preisgegeben.
            _mandant = null;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        // Das Logo selbst wird nicht geladen, nur ob es existiert; die Bilddatei kommt über /mandant-logo.
        var daten = await db.Mandanten.AsNoTracking()
            .Where(m => m.MandantNr == MandantNr)
            .Select(m => new
            {
                Mandant = new Mandant
                {
                    MandantNr = m.MandantNr, Bezeichnung = m.Bezeichnung, Aktiv = m.Aktiv, Geschaeftsfuehrer = m.Geschaeftsfuehrer,
                    Strasse = m.Strasse, Plz = m.Plz, Ort = m.Ort, Land = m.Land,
                    HrNummer = m.HrNummer, Amtsgericht = m.Amtsgericht, EoriNummer = m.EoriNummer, LucidId = m.LucidId,
                    Steuernummer = m.Steuernummer,
                    UstIdNr = m.UstIdNr, Telefon = m.Telefon, EMail = m.EMail, Bankname = m.Bankname, Iban = m.Iban,
                },
                HatLogo = m.Logo != null,
                m.GeaendertAm,
            })
            .FirstOrDefaultAsync();

        _mandant = daten?.Mandant;
        _hatLogo = daten?.HatLogo ?? false;
        _logoVersion = daten?.GeaendertAm.Ticks ?? 0;
    }

    private async Task Speichern()
    {
        _meldung = _fehler = null;
        if (_mandant is null || !_erlaubt) return;

        var bezeichnung = _mandant.Bezeichnung?.Trim() ?? "";
        if (bezeichnung.Length == 0)
        {
            _fehler = "Bitte einen Firmennamen eingeben.";
            return;
        }

        var plz = NullWennLeer(_mandant.Plz);
        if (plz is not null && !plz.All(char.IsAsciiDigit))
        {
            _fehler = "Die PLZ darf nur Ziffern enthalten.";
            return;
        }

        var telefon = NullWennLeer(_mandant.Telefon);
        if (telefon is not null && !telefon.All(char.IsAsciiDigit))
        {
            _fehler = "Die Telefonnummer darf nur Ziffern enthalten.";
            return;
        }

        var email = NullWennLeer(_mandant.EMail);
        if (email is not null && !System.Net.Mail.MailAddress.TryCreate(email, out _))
        {
            _fehler = "Die E-Mail-Adresse ist ungültig.";
            return;
        }

        var iban = OhneLeerzeichen(_mandant.Iban);
        if (iban is not null && !(LandMitZiffern(iban) && IbanGueltig(iban)))
        {
            _fehler = "Die IBAN ist ungültig (zwei Buchstaben, dann nur Ziffern; Länge oder Prüfziffer stimmt nicht).";
            return;
        }

        var ustIdNr = OhneLeerzeichen(_mandant.UstIdNr);
        if (ustIdNr is not null && !LandMitZiffern(ustIdNr))
        {
            _fehler = "Die USt-Id Nummer muss mit zwei Buchstaben beginnen, danach nur Ziffern.";
            return;
        }

        var eoriNummer = OhneLeerzeichen(_mandant.EoriNummer);
        if (eoriNummer is not null && !LandMitZiffern(eoriNummer))
        {
            _fehler = "Die EORI-Nummer muss mit zwei Buchstaben beginnen, danach nur Ziffern.";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var ziel = await db.Mandanten.FindAsync(MandantNr);
        if (ziel is null) return;

        ziel.Bankname = NullWennLeer(_mandant.Bankname);
        ziel.Iban = iban;
        ziel.Bezeichnung = bezeichnung;
        // Nur Admins (de)aktivieren Mandanten; das Feld ist für andere gar nicht sichtbar.
        if (_istAdmin) ziel.Aktiv = _mandant.Aktiv;
        ziel.Geschaeftsfuehrer = NullWennLeer(_mandant.Geschaeftsfuehrer);
        ziel.Strasse = NullWennLeer(_mandant.Strasse);
        ziel.Plz = plz;
        ziel.Ort = NullWennLeer(_mandant.Ort);
        ziel.Land = NullWennLeer(_mandant.Land);
        ziel.Telefon = telefon;
        ziel.EMail = email;
        ziel.HrNummer = NullWennLeer(_mandant.HrNummer);
        ziel.Amtsgericht = NullWennLeer(_mandant.Amtsgericht);
        ziel.Steuernummer = NullWennLeer(_mandant.Steuernummer);
        ziel.UstIdNr = ustIdNr;
        ziel.EoriNummer = eoriNummer;
        ziel.LucidId = NullWennLeer(_mandant.LucidId);
        await db.SaveChangesAsync();

        _meldung = "Mandant gespeichert.";
        await Laden();
    }

    private async Task LogoHochladen(InputFileChangeEventArgs e)
    {
        _meldung = _fehler = null;

        var (daten, contentType, fehler) = await LogoDatei.LesenAsync(e.File);
        if (fehler is not null)
        {
            _fehler = fehler;
            return;
        }

        await LogoSpeichern(daten, contentType);
        _meldung = "Logo gespeichert.";
    }

    private async Task LogoEntfernen()
    {
        _meldung = _fehler = null;
        await LogoSpeichern(null, null);
        _meldung = "Logo entfernt.";
    }

    private async Task LogoSpeichern(byte[]? daten, string? contentType)
    {
        if (!_erlaubt) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var ziel = await db.Mandanten.FindAsync(MandantNr);
        if (ziel is null) return;

        ziel.Logo = daten;
        ziel.LogoContentType = contentType;
        await db.SaveChangesAsync();

        _hatLogo = daten is not null;
        _logoVersion = ziel.GeaendertAm.Ticks;
    }

    // IBAN-Prüfung nach ISO 13616: Länge 15-34, die ersten vier Zeichen ans Ende, Buchstaben als
    // Zahlen 10-35, Rest durch 97 muss 1 ergeben.
    private static bool IbanGueltig(string iban)
    {
        if (iban.Length is < 15 or > 34 || !iban.All(char.IsAsciiLetterOrDigit)
            || !char.IsAsciiLetterUpper(iban[0]) || !char.IsAsciiLetterUpper(iban[1]))
        {
            return false;
        }

        var rest = 0;
        foreach (var c in iban[4..] + iban[..4])
        {
            var wert = char.IsAsciiDigit(c) ? c - '0' : c - 'A' + 10;
            rest = (wert < 10 ? rest * 10 + wert : rest * 100 + wert) % 97;
        }

        return rest == 1;
    }

    // Nummern wie IBAN, USt-Id und EORI: ohne Leerzeichen, Großbuchstaben, leer = null.
    private static string? OhneLeerzeichen(string? text) =>
        string.IsNullOrWhiteSpace(text) ? null : new string(text.Where(c => !char.IsWhiteSpace(c)).ToArray()).ToUpperInvariant();

    // Zwei Buchstaben als Ländercode, ab der 3. Stelle nur Ziffern.
    private static bool LandMitZiffern(string text) =>
        text.Length >= 3 && char.IsAsciiLetterUpper(text[0]) && char.IsAsciiLetterUpper(text[1]) && text[2..].All(char.IsAsciiDigit);

    private static string? NullWennLeer(string? text) => string.IsNullOrWhiteSpace(text) ? null : text.Trim();
}
