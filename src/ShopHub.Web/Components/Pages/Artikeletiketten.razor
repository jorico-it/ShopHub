@page "/artikeletiketten"
@using System.Globalization
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using ShopHub.Web.Data
@using ShopHub.Web.Services
@inherits MandantSeite
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JS

<PageTitle>Artikeletiketten</PageTitle>

@* Seitengröße und Druckregeln: beim Drucken bleiben nur die Etiketten übrig, eine Druckseite = Etiketten pro Reihe x Etiketten pro Spalte. *@
<style>@((MarkupString)Css)</style>

<div class="no-print">
    <h1>Artikeletiketten</h1>

    @if (MandantNr is null)
    {
        <div class="alert alert-warning">Dem Konto ist kein Mandant zugeordnet.</div>
        return;
    }

    <div class="border rounded p-3 mb-3">
        <h5>Etikettenformat</h5>
        <table class="table table-sm calc-table mb-0" style="width: auto;">
            <tbody>
                <tr>
                    <td class="calc-label">Breite (mm)</td>
                    <td style="text-align: left;"><input type="number" class="form-control form-control-sm" style="width: 55px; text-align: right;" min="@MinMm" max="@MaxMm" @bind="_breiteMm" @bind:after="SpeichereEinstellungenAsync" /></td>
                </tr>
                <tr>
                    <td class="calc-label">Höhe (mm)</td>
                    <td style="text-align: left;"><input type="number" class="form-control form-control-sm" style="width: 55px; text-align: right;" min="@MinMm" max="@MaxMm" @bind="_hoeheMm" @bind:after="SpeichereEinstellungenAsync" /></td>
                </tr>
                <tr>
                    <td class="calc-label">Etiketten pro Spalte</td>
                    <td style="text-align: left;"><input type="number" class="form-control form-control-sm" style="width: 55px; text-align: right;" min="1" max="@MaxProSpalte" @bind="_proSpalte" @bind:after="SpeichereEinstellungenAsync" /></td>
                </tr>
                <tr>
                    <td class="calc-label">Etiketten pro Reihe</td>
                    <td style="text-align: left;"><input type="number" class="form-control form-control-sm" style="width: 55px; text-align: right;" min="1" max="@MaxProReihe" @bind="_proReihe" @bind:after="SpeichereEinstellungenAsync" /></td>
                </tr>
            </tbody>
        </table>
        <div class="text-muted mt-2">
            Die Werte werden je Mandant gespeichert. Eine Druckseite enthält Etiketten pro Reihe (nebeneinander) mal Etiketten pro Spalte (übereinander)
            und ist entsprechend groß: @(_breiteMm * ProReihe) x @(_hoeheMm * ProSpalte) mm.
        </div>
        @if (BarcodeZuBreit)
        {
            <div class="text-danger mt-2">Der Barcode ist breiter als das Etikett - bitte die Etikettenbreite anpassen.</div>
        }
    </div>

    <div class="border rounded p-3 mb-3">
        <h5>Varianten auswählen</h5>
        <div class="d-flex align-items-center gap-3 mb-2">
            <input class="form-control form-control-sm" style="width: 320px;" placeholder="Artikelnummer, Bezeichnung oder EAN"
                   @bind="_suche" @bind:event="oninput" @onkeydown="SucheTaste" />
            <button type="button" class="btn btn-sm btn-primary" @onclick="Suchen">Suchen</button>
            <label class="mb-0">
                <input type="checkbox" class="form-check-input" @bind="_nurAktive" @bind:after="LadeAsync" /> nur aktive
            </label>
        </div>
        <div class="text-muted mb-2">Es werden nur Varianten mit EAN angeboten. Anzahl 0 = nicht drucken.</div>

        @if (_zeilen.Count == 0)
        {
            <p class="text-muted mb-0">Keine passenden Varianten gefunden.</p>
        }
        else
        {
            <table class="table table-sm calc-table mb-0" style="width: auto;">
                <thead>
                    <tr>
                        <th>Artikelnummer</th>
                        <th>Bezeichnung</th>
                        <th>EAN</th>
                        <th class="text-end">Anzahl</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var z in _zeilen)
                    {
                        <tr>
                            <td style="text-align: left;">@z.Artikelnummer</td>
                            <td style="text-align: left;">@z.Anzeigename</td>
                            <td style="text-align: left;">@z.GTIN</td>
                            <td class="text-end">
                                @if (z.Fehler is null)
                                {
                                    @* Text- statt Zahlenfeld: nur so lässt sich die Eingabe auf 3 Ziffern (höchstens 999) begrenzen. *@
                                    <input class="form-control form-control-sm anzahl-eingabe" style="width: 4rem; text-align: right;"
                                           maxlength="3" inputmode="numeric" value="@z.Anzahl" data-eingabefilter="ziffern" data-german-number-input
                                           @onchange="e => SetzeAnzahl(z, e.Value?.ToString())" />
                                }
                                else
                                {
                                    <span class="text-danger">@z.Fehler</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (_abgeschnitten)
            {
                <div class="text-muted mt-2">Nur die ersten @MaxZeilen Treffer werden angezeigt - bitte die Suche eingrenzen.</div>
            }
        }
    </div>

    <div class="border rounded p-3 mb-3">
        <h5>Drucken</h5>
        <p class="mb-2">Zu druckende Etiketten: <strong>@GesamtAnzahl.ToString("N0", German)</strong></p>
        @if (_auswahl.Values.Any(z => !z.HatMarkenlogo))
        {
            <p class="text-warning-emphasis mb-2">
                Hinweis: Bei @_auswahl.Values.Count(z => !z.HatMarkenlogo) gewählten Varianten hat die Marke kein Logo für Etiketten - diese Etiketten werden ohne Logo gedruckt (Pflege unter Marken, Spalte „Logo Etiketten“).
            </p>
        }
        <button type="button" class="btn btn-primary" disabled="@(GesamtAnzahl == 0)" @onclick="Drucken">Drucken</button>
        <button type="button" class="btn btn-outline-secondary" disabled="@(GesamtAnzahl == 0)" @onclick="AuswahlLeeren">Auswahl leeren</button>
        <div class="text-muted mt-2">Im Druckdialog den Etikettendrucker wählen, Ränder auf „Keine“ und Skalierung auf 100 % stellen.</div>
    </div>

    @if (GesamtAnzahl > 0)
    {
        <h5>Vorschau</h5>
        @if (GesamtAnzahl > VorschauEtiketten)
        {
            <div class="text-muted mb-2">Gezeigt werden die ersten @VorschauEtiketten Etiketten, gedruckt werden alle @GesamtAnzahl.ToString("N0", German).</div>
        }
    }
</div>

@* Vorschau (nur am Bildschirm): die ersten VorschauAnzahl Etiketten. *@
<div class="etiketten-vorschau no-print">
    @foreach (var z in Vorschau)
    {
        @Etikett(z)
    }
</div>

@* Vorlagen (nie sichtbar): je gewählter Variante genau ein Etikett. Beim Drucken vervielfältigt etikettendruck.js sie im Browser
   zu den Druckseiten; Blazor rendert und überträgt also nie jedes einzelne Etikett. *@
<div class="etiketten-vorlagen">
    @foreach (var z in _auswahl.Values.OrderBy(z => z.Artikelnummer).ThenBy(z => z.SKU))
    {
        <div class="etikett-vorlage" data-anzahl="@z.Anzahl">@Etikett(z)</div>
    }
</div>

@code {
    private const int MinMm = 20;
    private const int MaxMm = 200;
    private const int MaxZeilen = 100;
    private const int MaxAnzahl = 999;
    private const int MaxProReihe = 10;
    private const int MaxProSpalte = 10;

    // Auf dem Bildschirm zeigt die Vorschau nur die ersten Etiketten (ganze Druckseiten); gedruckt werden alle (siehe Css).
    private const int VorschauAnzahl = 3;

    private static readonly CultureInfo German = CultureInfo.GetCultureInfo("de-DE");

    private sealed class Zeile
    {
        public int ArtikelvarianteID { get; init; }
        public string Artikelnummer { get; init; } = "";
        public string SKU { get; init; } = "";
        public string Anzeigename { get; init; } = "";
        public string GTIN { get; init; } = "";
        // Namen der Bestandteile, wenn die Variante ein Bundle ist (mit "2 x " bei Menge über 1 und ihrer Größe dahinter); sonst leer.
        public IReadOnlyList<string> BundleNamen { get; init; } = [];
        public bool IstBundle => BundleNamen.Count > 0;
        public int? MarkeID { get; init; }
        public string? Markenname { get; init; }
        public bool HatMarkenlogo { get; init; }
        public long LogoVersion { get; init; }
        public bool[] Module { get; init; } = [];
        public string? Fehler { get; init; }
        public int Anzahl { get; set; }
    }

    private List<Zeile> _zeilen = [];
    // Gewählte Varianten bleiben erhalten, auch wenn die Suche sie gerade nicht anzeigt.
    private readonly Dictionary<int, Zeile> _auswahl = [];
    // _suche ist der getippte Text, _gesuchtNach der Text der letzten Suche (Schaltfläche "Suchen" oder Eingabetaste, wie in der Artikelliste).
    private string _suche = "";
    private string _gesuchtNach = "";
    private bool _nurAktive = true;
    private bool _abgeschnitten;
    // Etikettenformat: kommt je Mandant aus der Datenbank (siehe LadeAsync) und wird bei jeder Änderung gespeichert.
    private int _breiteMm = Models.Mandant.StandardEtikettBreiteMm;
    private int _hoeheMm = Models.Mandant.StandardEtikettHoeheMm;
    private int _proReihe = Models.Mandant.StandardEtikettenProReihe;
    private int _proSpalte = Models.Mandant.StandardEtikettenProSpalte;

    private int GesamtAnzahl => _auswahl.Values.Sum(z => z.Anzahl);

    private int ProReihe => Math.Clamp(_proReihe, 1, MaxProReihe);

    private int ProSpalte => Math.Clamp(_proSpalte, 1, MaxProSpalte);

    // Die ersten VorschauAnzahl Etiketten in Druckreihenfolge (je Variante so oft wie gewählt).
    private IEnumerable<Zeile> Vorschau => _auswahl.Values
        .OrderBy(z => z.Artikelnummer).ThenBy(z => z.SKU)
        .SelectMany(z => Enumerable.Repeat(z, Math.Min(z.Anzahl, VorschauAnzahl)))
        .Take(VorschauAnzahl);

    // Ein Etikett; Vorschau und Vorlagen zeigen es mit demselben Aufbau.
    private RenderFragment Etikett(Zeile z) => @<div class="etikett">
        <div class="etikett-kopf">
            @if (z.HatMarkenlogo)
            {
                <img class="etikett-logo" src="/marke-logo-etiketten/@z.MarkeID?v=@z.LogoVersion" alt="" />
            }
        </div>
        <div class="etikett-unten">
            <div class="etikett-text">
                <div class="etikett-artnr">@z.Artikelnummer</div>
                <div class="etikett-name">@(z.IstBundle ? "Bundle: " : "")@z.Anzeigename</div>
                @if (z.IstBundle)
                {
                    <div class="etikett-bundle">@string.Join(", ", z.BundleNamen)</div>
                }
            </div>
            <div class="etikett-code">
                <div class="etikett-barcode"><BarcodeSvg Module="z.Module" ModulbreiteMm="Strichbreite" /></div>
                <div class="etikett-gtin" style="@GtinStil(z.Module.Length)">
                    @foreach (var ziffer in z.GTIN)
                    {
                        <span>@ziffer</span>
                    }
                </div>
            </div>
        </div>
    </div>;

    private int VorschauEtiketten => Math.Min(GesamtAnzahl, VorschauAnzahl);

    private async Task SpeichereEinstellungenAsync()
    {
        _breiteMm = Math.Clamp(_breiteMm, MinMm, MaxMm);
        _hoeheMm = Math.Clamp(_hoeheMm, MinMm, MaxMm);
        _proReihe = ProReihe;
        _proSpalte = ProSpalte;
        if (MandantNr is not { } mandantNr) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        // Direkt per Update, damit GeaendertAm des Mandanten (Versionsnummer der Logo-Adressen) unberührt bleibt.
        await db.Mandanten.Where(m => m.MandantNr == mandantNr)
            .ExecuteUpdateAsync(s => s
                .SetProperty(m => m.EtikettBreiteMm, _breiteMm)
                .SetProperty(m => m.EtikettHoeheMm, _hoeheMm)
                .SetProperty(m => m.EtikettenProReihe, _proReihe)
                .SetProperty(m => m.EtikettenProSpalte, _proSpalte));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Pfeil hoch/runter springt zwischen den Mengenfeldern (wie in der Marktanalyse-App).
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/germanNumberInputNav.js");
            await module.InvokeVoidAsync("init");

            var filter = await JS.InvokeAsync<IJSObjectReference>("import", "/js/eingabefilter.js");
            await filter.InvokeVoidAsync("init");
        }
    }


    protected override async Task LadeAsync()
    {
        _zeilen = [];
        if (MandantNr is not { } mandantNr) return;

        await using var db = await DbFactory.CreateDbContextAsync();

        var format = await db.Mandanten.AsNoTracking()
            .Where(m => m.MandantNr == mandantNr)
            .Select(m => new { m.EtikettBreiteMm, m.EtikettHoeheMm, m.EtikettenProReihe, m.EtikettenProSpalte })
            .FirstOrDefaultAsync();
        if (format is not null)
        {
            _breiteMm = Math.Clamp(format.EtikettBreiteMm, MinMm, MaxMm);
            _hoeheMm = Math.Clamp(format.EtikettHoeheMm, MinMm, MaxMm);
            _proReihe = Math.Clamp(format.EtikettenProReihe, 1, MaxProReihe);
            _proSpalte = Math.Clamp(format.EtikettenProSpalte, 1, MaxProSpalte);
        }

        var abfrage = db.Artikelvarianten.AsNoTracking().Where(v => v.MandantNr == mandantNr && v.GTIN != null);
        if (_nurAktive)
        {
            abfrage = abfrage.Where(v => v.Aktiv && v.Artikel!.Aktiv);
        }

        var suche = _gesuchtNach;
        if (suche.Length > 0)
        {
            abfrage = abfrage.Where(v => v.GTIN!.Contains(suche)
                || (v.Variantenname != null && v.Variantenname.Contains(suche))
                || v.Artikel!.Artikelnummer.Contains(suche) || v.Artikel.Bezeichnung.Contains(suche));
        }

        var treffer = await abfrage
            .OrderBy(v => v.Artikel!.Artikelnummer).ThenBy(v => v.SKU)
            .Take(MaxZeilen + 1)
            .Select(v => new
            {
                v.ArtikelvarianteID, v.Artikel!.Artikelnummer, v.SKU, v.Artikel.Bezeichnung, v.Variantenname, v.GTIN,
                v.BundleElemente,
                v.Artikel.MarkeID,
                Markenname = v.Artikel.Marke != null ? v.Artikel.Marke.Markenname : null,
                // Nur ob ein Markenlogo existiert, nicht die Bilddaten laden.
                HatMarkenlogo = v.Artikel.Marke != null && v.Artikel.Marke.LogoEtiketten != null,
                MarkeGeaendertAm = v.Artikel.Marke != null ? (DateTime?)v.Artikel.Marke.GeaendertAm : null,
            })
            .ToListAsync();

        _abgeschnitten = treffer.Count > MaxZeilen;

        // Bestandteile aller angezeigten Bundles auf einmal auflösen: SKU -> Name.
        var bundles = treffer.Take(MaxZeilen).ToDictionary(t => t.ArtikelvarianteID, t => LeseBundleElemente(t.BundleElemente));
        var bundleSkus = bundles.Values.SelectMany(e => e).Select(e => e.SKU).Distinct().ToList();
        Dictionary<string, string> bestandteile = bundleSkus.Count == 0
            ? []
            : (await db.Artikelvarianten.AsNoTracking()
                .Where(v => v.MandantNr == mandantNr && bundleSkus.Contains(v.SKU))
                .Select(v => new { v.SKU, v.Artikel!.Bezeichnung, v.Artikel.Kurzbeschreibung, v.Variantenname, v.Variantenmerkmale })
                .ToListAsync())
                .ToDictionary(v => v.SKU, v => Bestandteilname(v.Bezeichnung, v.Kurzbeschreibung, v.Variantenname, v.Variantenmerkmale), StringComparer.OrdinalIgnoreCase);

        _zeilen = treffer.Take(MaxZeilen).Select(t =>
        {
            // Schon gewählte Zeilen weiterverwenden, damit ihre Anzahl sichtbar bleibt.
            if (_auswahl.TryGetValue(t.ArtikelvarianteID, out var vorhanden)) return vorhanden;

            var geeignet = GtinBarcode.TryErzeugen(t.GTIN, out var module, out var fehler);
            return new Zeile
            {
                ArtikelvarianteID = t.ArtikelvarianteID,
                Artikelnummer = t.Artikelnummer,
                SKU = t.SKU,
                Anzeigename = Anzeigename(t.Bezeichnung, t.Variantenname),
                GTIN = t.GTIN!.Trim(),
                BundleNamen = bundles[t.ArtikelvarianteID]
                    .Select(e => (e.Menge > 1 ? $"{e.Menge} x " : "") + bestandteile.GetValueOrDefault(e.SKU, e.SKU))
                    .ToList(),
                MarkeID = t.MarkeID,
                Markenname = t.Markenname,
                HatMarkenlogo = t.HatMarkenlogo,
                LogoVersion = t.MarkeGeaendertAm?.Ticks ?? 0,
                Module = geeignet ? module : [],
                Fehler = fehler,
            };
        }).ToList();
    }

    private static string Anzeigename(string bezeichnung, string? variantenname) =>
        string.IsNullOrWhiteSpace(variantenname) ? bezeichnung : $"{bezeichnung} – {variantenname}";

    // Kurzname eines Bundle-Bestandteils: das Merkmal "Tiername" der Variante. Fehlt es, die Kurzbeschreibung des Artikels.
    // Fehlt auch die, dient die Bezeichnung. Hat die Variante das Merkmal "Größe", steht sie dahinter.
    private static string Bestandteilname(string bezeichnung, string? kurzbeschreibung, string? variantenname, string? variantenmerkmale)
    {
        var tiername = LeseMerkmal(variantenmerkmale, "Tiername");
        var name = !string.IsNullOrWhiteSpace(tiername) ? tiername.Trim()
            : !string.IsNullOrWhiteSpace(kurzbeschreibung) ? kurzbeschreibung.Trim()
            : Anzeigename(bezeichnung, variantenname);

        var groesse = LeseMerkmal(variantenmerkmale, "Größe")?.Trim();
        return string.IsNullOrEmpty(groesse) ? name : $"{name} {groesse}";
    }

    // Variantenmerkmale ist ein JSON-Objekt {"Tiername":"Einhorn","Größe":"L"}; ein nicht lesbarer Inhalt zählt als "kein Merkmal".
    private static string? LeseMerkmal(string? json, string name)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;

        try
        {
            using var dokument = JsonDocument.Parse(json);
            return dokument.RootElement.TryGetProperty(name, out var wert) && wert.ValueKind == JsonValueKind.String
                ? wert.GetString()
                : null;
        }
        catch (Exception ex) when (ex is JsonException or InvalidOperationException)
        {
            return null;
        }
    }

    // BundleElemente ist ein JSON-Array [{"SKU":"B1008","Menge":1}]; ein nicht lesbarer Inhalt zählt als "kein Bundle".
    private static List<(string SKU, int Menge)> LeseBundleElemente(string? json)
    {
        var elemente = new List<(string, int)>();
        if (string.IsNullOrWhiteSpace(json)) return elemente;

        try
        {
            using var dokument = JsonDocument.Parse(json);
            foreach (var element in dokument.RootElement.EnumerateArray())
            {
                var sku = element.GetProperty("SKU").GetString()?.Trim();
                if (!string.IsNullOrEmpty(sku))
                {
                    elemente.Add((sku, element.GetProperty("Menge").GetInt32()));
                }
            }
        }
        catch (Exception ex) when (ex is JsonException or InvalidOperationException or KeyNotFoundException or FormatException)
        {
            return [];
        }

        return elemente;
    }

    private async Task Suchen()
    {
        _gesuchtNach = _suche.Trim();
        await LadeAsync();
    }

    private async Task SucheTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Suchen();
    }

    private void SetzeAnzahl(Zeile zeile, string? wert)
    {
        zeile.Anzahl = int.TryParse(wert, out var anzahl) ? Math.Clamp(anzahl, 0, MaxAnzahl) : 0;
        if (zeile.Anzahl > 0)
        {
            _auswahl[zeile.ArtikelvarianteID] = zeile;
        }
        else
        {
            _auswahl.Remove(zeile.ArtikelvarianteID);
        }
    }

    private void AuswahlLeeren()
    {
        foreach (var z in _auswahl.Values)
        {
            z.Anzahl = 0;
        }

        _auswahl.Clear();
    }

    // Die Druckseiten baut der Browser aus den Vorlagen (Reihen x Spalten); der Aufruf kehrt sofort zurück.
    private async Task Drucken()
    {
        var modul = await JS.InvokeAsync<IJSObjectReference>("import", "/js/etikettendruck.js");
        await modul.InvokeVoidAsync("drucke", ProReihe, ProSpalte);
    }
}
