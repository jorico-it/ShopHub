@page "/"
@using ShopifySQL.Web.Data
@inject AppDbContext Db

<PageTitle>JORICO ShopHub</PageTitle>

<h1>JORICO ShopHub</h1>

<p>Pflege der Shopify-Daten in der SQL-Server-Datenbank.</p>

<p>
    Datenbankverbindung:
    @if (_connected is null)
    {
        <span>wird geprüft …</span>
    }
    else if (_connected == true)
    {
        <span class="text-success">verbunden</span>
    }
    else
    {
        <span class="text-danger">nicht verfügbar (Connection String in den User Secrets prüfen)</span>
    }
</p>

@code {
    private bool? _connected;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _connected = await Db.Database.CanConnectAsync();
        }
        catch (Exception)
        {
            // Fehlender oder ungültiger Connection String soll die Startseite nicht abbrechen.
            _connected = false;
        }
    }
}
