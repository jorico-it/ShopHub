@page "/login-protokoll"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ShopifySQL.Web.Data
@using ShopifySQL.Web.Services
@attribute [Authorize(Policy = "AdminOnly")]
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

@* Näherungsweises Login-Protokoll aus jorBesucherLog (siehe Program.cs, Middleware "Seitenaufrufe protokollieren") -
   es gibt keinen eigenen Login-Event, sondern nur ein Seitenaufruf-Log je Request mit der E-Mail des angemeldeten
   Nutzers. Ein "Login" wird hier als erster Seitenaufruf eines Nutzers an einem (deutschen) Kalendertag genähert.
   Die Gruppierung läuft in C#, nicht per SQL, weil ErstelltAm UTC ist und ein Gruppieren nach UTC-Datum an den
   Tagesgrenzen um Mitternacht deutscher Zeit einen Tag verrutschen würde. *@

<PageTitle>Login-Protokoll</PageTitle>

<h1>Login-Protokoll</h1>
<p class="text-muted">
    Erster/letzter Seitenaufruf je Nutzer und Tag der letzten @ZeitraumTage Tage (Näherung, da kein eigenes
    Login-Event protokolliert wird).
</p>

@if (_eintraege.Count == 0)
{
    <p class="text-muted">Noch keine Zugriffe protokolliert.</p>
}
else
{
    <PaginationControls Page="_seite" TotalPages="_seitenAnzahl" OnPageChange="GeheZuSeite" />
    <div class="table-responsive">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Nutzer</th>
                    <th>Tag</th>
                    <th>Erster Zugriff</th>
                    <th>Letzter Zugriff</th>
                    <th class="text-end">Aufrufe</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eintrag in _eintraege)
                {
                    <tr>
                        <td>@eintrag.Email</td>
                        <td>@eintrag.Tag.ToString("dd.MM.yyyy")</td>
                        <td>@GermanTime.Format(eintrag.ErsterUtc)</td>
                        <td>@GermanTime.Format(eintrag.LetzterUtc)</td>
                        <td class="text-end">@eintrag.Anzahl.ToString("N0", German)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <PaginationControls Page="_seite" TotalPages="_seitenAnzahl" OnPageChange="GeheZuSeite" />
}

@code {
    private static readonly System.Globalization.CultureInfo German = System.Globalization.CultureInfo.GetCultureInfo("de-DE");
    private static readonly TimeZoneInfo DeutscheZeitzone = TimeZoneInfo.FindSystemTimeZoneById("W. Europe Standard Time");

    private const int SeitenGroesse = 50;
    private const int ZeitraumTage = 180;

    private List<LoginEintrag> _eintraege = [];
    private List<LoginEintrag> _alleEintraege = [];
    private int _seite = 1;
    private int _seitenAnzahl = 1;

    protected override async Task OnInitializedAsync()
    {
        // Nur E-Mail und Zeitstempel der letzten Monate laden (Pfad/IP/User-Agent werden hier nicht gebraucht).
        var seit = DateTime.UtcNow.AddDays(-ZeitraumTage);
        await using var db = await DbFactory.CreateDbContextAsync();
        var roh = await db.BesucherLogs.AsNoTracking()
            .Where(b => b.Email != null && b.ErstelltAm >= seit)
            .Select(b => new { Email = b.Email!, b.ErstelltAm })
            .ToListAsync();

        _alleEintraege = roh
            .GroupBy(b => (b.Email, Tag: DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.SpecifyKind(b.ErstelltAm, DateTimeKind.Utc), DeutscheZeitzone))))
            .Select(g => new LoginEintrag(g.Key.Email, g.Key.Tag, g.Min(x => x.ErstelltAm), g.Max(x => x.ErstelltAm), g.Count()))
            .OrderByDescending(e => e.Tag)
            .ThenByDescending(e => e.LetzterUtc)
            .ToList();

        SeiteAnwenden();
    }

    private void GeheZuSeite(int seite)
    {
        if (seite < 1 || seite > _seitenAnzahl) return;
        _seite = seite;
        SeiteAnwenden();
    }

    private void SeiteAnwenden()
    {
        _seitenAnzahl = Math.Max(1, (int)Math.Ceiling(_alleEintraege.Count / (double)SeitenGroesse));
        _seite = Math.Clamp(_seite, 1, _seitenAnzahl);
        _eintraege = _alleEintraege.Skip((_seite - 1) * SeitenGroesse).Take(SeitenGroesse).ToList();
    }

    private sealed record LoginEintrag(string Email, DateOnly Tag, DateTime ErsterUtc, DateTime LetzterUtc, int Anzahl);
}
